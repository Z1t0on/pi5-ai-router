# ---------------------------------------------------------------------------
# pi5-ai-router — variables d'environnement (copier en `.env` et renseigner)
# Ne jamais committer le fichier `.env` réel ni afficher ses valeurs.
# ---------------------------------------------------------------------------

# --- Routeur ---------------------------------------------------------------
ROUTER_PORT=4000
RULES_FILE_PATH=config/routing_rules.json
SQLITE_DB_PATH=data/router_logs.db
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=/app/.cache/fastembed

# --- Verrou financier AWS Bedrock (true = 100 % des appels bloqués) --------
BEDROCK_LOCKED=true

# --- Fournisseurs : clés lues dynamiquement depuis routing_rules.json -----
# Providers principaux (free tier & crédits)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
ZAI_API_KEY=

# Providers secondaires / haute capacité
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
OPENCODE_API_KEY=

# AWS Bedrock (protégé par BEDROCK_LOCKED=true)
AWS_BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
